server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: let react-router handle client-side routes
    location / {
        try_files $uri /index.html;
    }

    # hashed build assets are immutable; long cache is safe
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}